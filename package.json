{
  "name": "vi-voice",
  "displayName": "Vi Voice",
  "description": "Gõ tiếng Việt bằng giọng nói vào terminal, Copilot Chat và editor",
  "version": "0.1.0",
  "publisher": "trongld",
  "license": "MIT",
  "engines": { "vscode": "^1.100.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "viVoice.toggle", "title": "Vi Voice: Bắt đầu / dừng nghe" },
      { "command": "viVoice.setApiKey", "title": "Vi Voice: Set Groq API Key" },
      { "command": "viVoice.retry", "title": "Vi Voice: Gửi lại audio cuối" }
    ],
    "keybindings": [
      { "command": "viVoice.toggle", "key": "ctrl+alt+space", "args": { "target": "clipboard" } },
      { "command": "viVoice.toggle", "key": "ctrl+alt+space", "when": "editorTextFocus", "args": { "target": "editor" } },
      { "command": "viVoice.toggle", "key": "ctrl+alt+space", "when": "inChatInput", "args": { "target": "chat" } },
      { "command": "viVoice.toggle", "key": "ctrl+alt+space", "when": "terminalFocus", "args": { "target": "terminal" } }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
